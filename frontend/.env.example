# Couche de mock MSW. Mettre `disabled` une fois le backend de Thư disponible.
NEXT_PUBLIC_API_MOCKING=enabled

# URL du backend réel utilisé par src/lib/api/client.ts (contrat d'API, MSW). Vide =
# requêtes relatives interceptées par MSW.
NEXT_PUBLIC_API_BASE_URL=

# URL du backend réel de Thư, pour les endpoints qu'il couvre déjà (authentification,
# documents, exigences — voir docs/backend-integration.md). Laisser vide pour rester
# entièrement sur le mock. Voir scripts/local-dev/README.md pour le faire tourner en
# local, sans PostgreSQL.
#
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
#
# Vercel : les fichiers .env* sont gitignorés et n'y arrivent jamais. Définir ces variables
# dans les paramètres du projet Vercel (URL publique HTTPS du backend hébergé, pas l'URL de la
# base Neon), puis redéployer : les NEXT_PUBLIC_* sont figées au build.
NEXT_PUBLIC_BACKEND_URL=https://debian-01.taila5effd.ts.net:8443
