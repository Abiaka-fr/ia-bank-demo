# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=abc
DB_PASSWORD=abc
DB_NAME=abc

# Full connection string for SQLAlchemy
DATABASE_URL=postgresql+psycopg://abc:́́́*****@localhost:5432/abc

# App settings
ENVIRONMENT=development

# OpenRouter API (for pipeline ingestion)
OPENROUTER_API_KEY=sk-or-v1....

# JWT signing key. The default is public: set a random value on any shared instance
# (python -c "import secrets; print(secrets.token_urlsafe(48))"). Without it the app
# starts with the public default and logs a warning.
# SECRET_KEY=

# OpenRouter key dedicated to the Compliance Copilot (POST /api/copilot/ask)
# CHAT_BOT_KEY=sk-or-v1....

# Allowed browser origins, as a JSON list
# CORS_ORIGINS=["http://localhost:3000","https://your-frontend.example"]
